PORT=5000
NODE_ENV=production

# URLs for CORS and Redirection
LOCAL_URL="http://localhost:5173"
WEB_URL="https://mpji-campus-sync.vercel.app"
FRONTEND_URL="https://mpji-campus-sync.vercel.app"

# Database Connection (MongoDB Atlas or self-hosted)
MONGO_URL=""

# Authentication & Sessions
JWT_SECRET=""
JWT_EXPIRE="5d"
COOKIE_EXPIRE=90

# Razorpay Credentials (Live keys for production)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Email Service (Resend / SMTP)
RESEND_API_KEY=""
SMTP_HOST="smtp.resend.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_SERVICE="resend"

# Gmail OAuth (Optional fallback)
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_USER_EMAIL=""
